#!/usr/bin/env sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

CADENCE_BIN="${CADENCE_BIN:-cadence}"

pnpm run typecheck
pnpm run build
pnpm run verify
python3 scripts/package_app.py check --source app

CHECK_TMP=$(mktemp -d)
trap 'rm -rf "$CHECK_TMP"' EXIT

set +e
"$CADENCE_BIN" app check app --json > "$CHECK_TMP/app-check.json"
status=$?
set -e
if [ "$status" -ne 0 ] && [ "$status" -ne 3 ]; then
  echo "app check failed with exit ${status}" >&2
  cat "$CHECK_TMP/app-check.json" >&2 || true
  exit 1
fi
python3 .github/scripts/assert-app-check.py "$CHECK_TMP/app-check.json"

pnpm test

python3 scripts/package_app.py build --source app --outdir "$CHECK_TMP/a" > "$CHECK_TMP/build-a.json"
python3 scripts/package_app.py build --source app --outdir "$CHECK_TMP/b" > "$CHECK_TMP/build-b.json"
ARCHIVE_A=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['archive'])" "$CHECK_TMP/build-a.json")
SIDECAR_A=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['sidecar'])" "$CHECK_TMP/build-a.json")
ARCHIVE_B=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['archive'])" "$CHECK_TMP/build-b.json")
SIDECAR_B=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['sidecar'])" "$CHECK_TMP/build-b.json")
cmp "$ARCHIVE_A" "$ARCHIVE_B"
cmp "$SIDECAR_A" "$SIDECAR_B"
python3 scripts/package_app.py verify "$ARCHIVE_A" > /dev/null
echo "Meeting minutes pre-push gate passed."
